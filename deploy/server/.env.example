# Production settings for compose.server.yaml (host Nginx).
#
# Copy this file to deploy/server/.env, keep mode 0600, and never commit it.
# Start from the repository root:
#   docker compose --env-file deploy/server/.env -f compose.server.yaml pull keepalive
#   docker compose --env-file deploy/server/.env -f compose.server.yaml up -d
#
# The public hostname and TLS certificate are configured in
# deploy/server/nginx.conf.example; Nginx runs on the host, not in Compose.

# Published image. Use an immutable commit-SHA tag in production; "latest" is
# acceptable only for development or a short-lived verification deployment.
KEEPALIVE_IMAGE=ghcr.io/wangming884/blitz-keepalive
KEEPALIVE_IMAGE_TAG=REPLACE_WITH_COMMIT_SHA

# Loopback-only host port used by Nginx. Do not bind this port to 0.0.0.0.
KEEPALIVE_HTTP_PORT=8090

# Single-browser default: 2 GB leaves headroom for the app, Chromium,
# the host Nginx process, and the operating system.
KEEPALIVE_MEM_LIMIT=2g

# Chromium uses shared memory heavily. 512mb is the single-browser default.
KEEPALIVE_SHM_SIZE=512mb

# Required on first start unless data/admin-auth.json already exists. Use a
# long random value. After changing the password in /admin, the persistent
# scrypt file takes precedence, but keeping this value in .env is still safest.
ADMIN_PASSWORD=

# Optional read-only token for monitoring. Send it in a request header only.
STATUS_TOKEN=

INTERVAL_MIN=20
JITTER_MIN=2
# compose.server.yaml pins the production profile to one Chromium.
MAX_CONCURRENT=1
SESSION_IDLE_TIMEOUT_MIN=60

# Nginx terminates TLS and forwards X-Forwarded-* headers. Keep these enabled
# in production so cookies are Secure and client-IP rate limiting works.
REQUIRE_HTTPS=true
TRUST_PROXY=true

# Comma-separated source CIDRs allowed to supply forwarding headers.
# 172.31.0.1 is the gateway of the private network in compose.server.yaml;
# 127.0.0.1 covers Docker Desktop/userland-proxy behavior. If you change the
# network subnet, update this value as well.
TRUST_PROXY_CIDRS=127.0.0.1/32,172.31.0.1/32

# Keep target navigation limited to the domains you intend to keep awake.
# Comma/semicolon/space-separated. Use *.example.com wildcard form.
TARGET_URL_ALLOWLIST=*.blitz.cloud
TARGET_URL_ALLOW_PRIVATE=false
TARGET_URL_STRICT_SUBRESOURCES=false

# Optional HTTP/SOCKS proxy. Leave empty for direct connections.
PROXY_URL=
PROXY_USERNAME=
PROXY_PASSWORD=
PROXY_BYPASS=
