# blitz.cloud keep-alive settings (read by `node --env-file=.env keepalive.mjs`)

# ---------------------------------------------------------------------------
# Mode A - one app
# ---------------------------------------------------------------------------
# Public address of the app to keep awake.
BLITZ_URL=https://example.yourname.blitz.cloud

# Recommended: a piece of text that only the running app renders.
EXPECT_TEXT=

# ---------------------------------------------------------------------------
# Mode B - many apps / many accounts
# ---------------------------------------------------------------------------
# Path to a JSON target list (see config.example.json). When set, BLITZ_URL
# must stay empty. Use either mode, never both.
CONFIG_FILE=

# ---------------------------------------------------------------------------
# Shared settings
# ---------------------------------------------------------------------------
# Global visit interval. Per-target values in the JSON file take precedence.
# Leave empty to use the built-in default (20 minutes). In multi mode keep it
# empty so each target's intervalMin from the JSON file applies.
INTERVAL_MIN=

# Random extra delay, 0..N minutes. Empty = 2 minutes.
JITTER_MIN=

# How many apps are visited at the same time (each in its own browser).
MAX_CONCURRENT=2

HEADLESS=true
LOG_DIR=logs

# Docker / blitz.cloud only: the image must answer on a port, otherwise blitz
# keeps the app in "Starting". 8080 matches EXPOSE in the Dockerfile.
PORT=

# Interface used by the built-in management/health server. Keep 127.0.0.1 for
# local use; containers and reverse-proxy deployments normally use 0.0.0.0.
BIND_HOST=127.0.0.1

# ---------------------------------------------------------------------------
# Management console authentication
# ---------------------------------------------------------------------------
# Required when PORT is set unless ADMIN_PASSWORD_FILE already contains a
# password. This is the password used by the /admin login page. Use a long,
# random value and serve the console over HTTPS.
ADMIN_PASSWORD=

# Optional persistent password override. The /admin security dialog writes a
# scrypt hash here (never plaintext) and this file takes precedence over
# ADMIN_PASSWORD after the first web password change. Keep it on a persistent
# volume together with managed-targets.json.
ADMIN_PASSWORD_FILE=data/admin-auth.json

# Optional read-only API token for scripts and monitoring. Send it with
# X-Status-Token or Authorization: Bearer. It cannot log in to /admin, cannot
# unlock the browser console, and cannot perform write operations.
STATUS_TOKEN=

# Require HTTPS for the console and all APIs. /healthz remains available over
# plain HTTP for container and load-balancer probes.
REQUIRE_HTTPS=false

# Only enable behind a reverse proxy you control. The direct peer must be in
# TRUST_PROXY_CIDRS before X-Forwarded-* headers are honored.
TRUST_PROXY=false
TRUST_PROXY_CIDRS=

# Absolute session lifetime is 12 hours; this controls the idle timeout.
SESSION_IDLE_TIMEOUT_MIN=60

# Web-managed targets are persisted here (atomic writes, mode 0600). The data
# directory should be mounted as a volume in Docker.
MANAGED_TARGETS_FILE=data/managed-targets.json

# ---------------------------------------------------------------------------
# Target-site login passwords
# ---------------------------------------------------------------------------
# Optional 32-byte key (base64 or 64 hex characters) used to encrypt passwords
# entered for web-managed targets. If omitted, the key file below is generated
# automatically. Back up the key together with managed-targets.json: without
# it, saved target passwords cannot be decrypted.
TARGET_SECRET_KEY=
TARGET_SECRET_KEY_FILE=data/target-secrets.key

# ---------------------------------------------------------------------------
# Network proxy (HTTP / HTTPS / SOCKS)
# ---------------------------------------------------------------------------
# Examples:
#   PROXY_URL=http://proxy.example.com:8080
#   PROXY_URL=socks5://127.0.0.1:1080
# Leave empty for a direct connection. A target in the JSON file can override
# this with its own "proxy" field ("" means direct for that target).
PROXY_URL=

# Basic auth for HTTP(S) proxies. Prefer these over --proxy-user/--proxy-pass:
# command-line arguments are visible in the process list.
# Chromium does not support SOCKS authentication; use an IP-allowlisted proxy.
PROXY_USERNAME=
PROXY_PASSWORD=

# Hosts that skip the proxy (comma/semicolon separated). NO_PROXY is used as a
# fallback when this is empty.
PROXY_BYPASS=
# ---------------------------------------------------------------------------
# Target URL safety
# ---------------------------------------------------------------------------
# Comma/semicolon/space-separated hostname allowlist. Wildcards must be in the
# form *.example.com. The default keeps browser visits limited to blitz.cloud.
TARGET_URL_ALLOWLIST=*.blitz.cloud

# Private, loopback, link-local and metadata addresses stay blocked by default.
# Enable only for trusted local testing.
TARGET_URL_ALLOW_PRIVATE=false

# ---------------------------------------------------------------------------
# Browser and failure diagnostics
# ---------------------------------------------------------------------------
# Set true only in a container that already has its own security boundary.
CHROME_NO_SANDBOX=false

# Failure screenshots/HTML dumps are disabled by default. When enabled, old
# files are pruned by count and age.
DUMP_FAILURES=false
FAILURE_DUMP_MAX_FILES=100
FAILURE_DUMP_MAX_AGE_DAYS=7
